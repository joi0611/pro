  },
  {
    "set": "adora",
    "text": "sail",
    "file": "assets/audio/adora/df8c165555a5.mp3"
  },
  {
    "set": "adora",
    "text": "My cruise to Jeju.",
    "file": "assets/audio/adora/09a3a130d0c1.mp3"
  },
  {
    "set": "adora",
    "text": "The Adora Magic City is a huge ship.",
    "file": "assets/audio/adora/30a636e787f1.mp3"
  },
  {
    "set": "adora",
    "text": "It is as long as three football fields!",
    "file": "assets/audio/adora/7d0652de687f.mp3"
  },
  {
    "set": "adora",
    "text": "The ship floats on the sea.",
    "file": "assets/audio/adora/e62da60aff58.mp3"
  },
  {
    "set": "adora",
    "text": "Air inside pushes it up.",
    "file": "assets/audio/adora/ebb3f88c00b6.mp3"
  },
  {
    "set": "adora",
    "text": "We leave Shanghai at night.",
    "file": "assets/audio/adora/cd9eb2ec965c.mp3"
  },
  {
    "set": "adora",
    "text": "The city lights get small, small, small.",
    "file": "assets/audio/adora/7dfbe8c5761a.mp3"
  },
  {
    "set": "adora",
    "text": "In the morning, a dolphin jumps beside our ship.",
    "file": "assets/audio/adora/81e9677a9ce4.mp3"
  },
  {
    "set": "adora",
    "text": "Jeju is a volcano island.",
    "file": "assets/audio/adora/c053b4801695.mp3"
  },
  {
    "set": "adora",
    "text": "A volcano made it long, long ago.",
    "file": "assets/audio/adora/00dc5bc9b54c.mp3"
  },
  {
    "set": "adora",
    "text": "Hallasan is the tallest mountain in Korea.",
    "file": "assets/audio/adora/96657f538736.mp3"
  },
  {
    "set": "adora",
    "text": "It is 1,950 meters high!",
    "file": "assets/audio/adora/705f286eb376.mp3"
  },
  {
    "set": "adora",
    "text": "Dol Hareubang guards Jeju.",
    "file": "assets/audio/adora/be4432a503bf.mp3"
  },
  {
    "set": "adora",
    "text": "Touch his nose for luck!",
    "file": "assets/audio/adora/7b709d874df9.mp3"
  },
  {
    "set": "adora",
    "text": "Jeju is full of sweet oranges.",
    "file": "assets/audio/adora/ad5219dd8f23.mp3"
  },
  {
    "set": "adora",
    "text": "I pick one for breakfast.",
    "file": "assets/audio/adora/c9087b9391a2.mp3"
  },
  {
    "set": "adora",
    "text": "Haenyeo dive into the sea without air tanks.",
    "file": "assets/audio/adora/7aa6d038a301.mp3"
  },
  {
    "set": "adora",
    "text": "They are so brave!",
    "file": "assets/audio/adora/312a938ae311.mp3"
  },
  {
    "set": "adora",
    "text": "We sail back to Shanghai.",
    "file": "assets/audio/adora/da6b7317585f.mp3"
  },
  {
    "set": "adora",
    "text": "Goodbye, Jeju! I love my cruise trip!",
    "file": "assets/audio/adora/ed0b65a7558c.mp3"
  },
