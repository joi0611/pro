  },
  {
    "set": "dounan",
    "text": "This is Dounan.",
    "file": "assets/audio/dounan/6629f5d90f7a.mp3"
  },
  {
    "set": "dounan",
    "text": "It is a big flower market.",
    "file": "assets/audio/dounan/c1d7a53cbdb7.mp3"
  },
  {
    "set": "dounan",
    "text": "Wow! So many flowers!",
    "file": "assets/audio/dounan/3223e1ff4654.mp3"
  },
  {
    "set": "dounan",
    "text": "Red, yellow, pink and blue.",
    "file": "assets/audio/dounan/6299cb461adc.mp3"
  },
  {
    "set": "dounan",
    "text": "Look at the roses.",
    "file": "assets/audio/dounan/03b2d3ec7de5.mp3"
  },
  {
    "set": "dounan",
    "text": "How much is it?",
    "file": "assets/audio/dounan/c098beb15f53.mp3"
  },
  {
    "set": "dounan",
    "text": "\"Ten yuan!\" says the man.",
    "file": "assets/audio/dounan/a60c130735fb.mp3"
  },
  {
    "set": "dounan",
    "text": "Look at the sunflower.",
    "file": "assets/audio/dounan/ffb6cbb0dee8.mp3"
  },
  {
    "set": "dounan",
    "text": "It is big and yellow.",
    "file": "assets/audio/dounan/ca15100a50f1.mp3"
  },
  {
    "set": "dounan",
    "text": "\"Five yuan!\" he says.",
    "file": "assets/audio/dounan/215b622d1dd3.mp3"
  },
  {
    "set": "dounan",
    "text": "I see a lily.",
    "file": "assets/audio/dounan/59eded6d7366.mp3"
  },
  {
    "set": "dounan",
    "text": "I see a carnation.",
    "file": "assets/audio/dounan/ce2c20206f72.mp3"
  },
  {
    "set": "dounan",
    "text": "The carnation is for Mom.",
    "file": "assets/audio/dounan/341802a91e70.mp3"
  },
  {
    "set": "dounan",
    "text": "\"How much is it?\" I ask.",
    "file": "assets/audio/dounan/c8651cb70c60.mp3"
  },
  {
    "set": "dounan",
    "text": "\"Eight yuan.\"",
    "file": "assets/audio/dounan/4b0bac71bd92.mp3"
  },
  {
    "set": "dounan",
    "text": "So cheap!",
    "file": "assets/audio/dounan/5e3564e22667.mp3"
  },
  {
    "set": "dounan",
    "text": "In my city, one rose is ten yuan.",
    "file": "assets/audio/dounan/6c9670dfca8f.mp3"
  },
  {
    "set": "dounan",
    "text": "Here, ten yuan buys many roses!",
    "file": "assets/audio/dounan/47f3243e19b5.mp3"
  },
  {
    "set": "dounan",
    "text": "Look! The price in Xinjiang is sixty yuan.",
    "file": "assets/audio/dounan/78dc7e6cb4c5.mp3"
  },
  {
    "set": "dounan",
    "text": "Too expensive! Why?",
    "file": "assets/audio/dounan/ab2ad3a8f584.mp3"
  },
  {
    "set": "dounan",
    "text": "The flowers go by truck.",
    "file": "assets/audio/dounan/87bfaa3dbbfa.mp3"
  },
  {
    "set": "dounan",
    "text": "They go by plane.",
    "file": "assets/audio/dounan/4e593183ecfa.mp3"
  },
  {
    "set": "dounan",
    "text": "It is a long, long way.",
    "file": "assets/audio/dounan/2e50e502914b.mp3"
  },
  {
    "set": "dounan",
    "text": "Some flowers are sad on the way.",
    "file": "assets/audio/dounan/c6778bc75591.mp3"
  },
  {
    "set": "dounan",
    "text": "So the price goes up.",
    "file": "assets/audio/dounan/7b654464ab9c.mp3"
  },
  {
    "set": "dounan",
    "text": "I have 100 yuan.",
    "file": "assets/audio/dounan/902ee0dd9512.mp3"
  },
  {
    "set": "dounan",
    "text": "It is my money.",
    "file": "assets/audio/dounan/4d91a22e4c7e.mp3"
  },
  {
    "set": "dounan",
    "text": "What can I buy? Let me see!",
    "file": "assets/audio/dounan/b8337be25e7e.mp3"
  },
  {
    "set": "dounan",
    "text": "I love the flower market.",
    "file": "assets/audio/dounan/b646e2b84369.mp3"
  },
  {
    "set": "dounan",
    "text": "Flowers go far. Love goes far, too.",
    "file": "assets/audio/dounan/f3b735445c3b.mp3"
  },
